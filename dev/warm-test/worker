#!/usr/bin/env bash
# dev/warm-test — std/bash's script interpreter, on an image whose runner
# stays warm for a minute after each job (flake.nix). Fetch `worker1` and run
# it with bash.
set -euo pipefail

caos get /cas/args/worker1
bash /cas/args/worker1
if [ ! -e /cas/out ]; then
  : > /tmp/caos-empty-out
  caos put /tmp/caos-empty-out /cas/out
fi
