# The REPO's root expression (design/caos-expr.md, "Deep deps"; design/nix-bootstrap.md,
# section 3). Any directory in this tree may carry a `DEPS` file naming what it
# depends on by PATH, and evaluating the tree mounts each dependency — recursively
# deepened and shared by hash — inside the directory that declared it, at
# `DEEP-DEPS/<name>`.
#
# The CORE (runner, flake-builder, cargo, rustc, deep-deps) is no longer seeded. It
# is built here, from THIS tree's own flake, by the `nix=v1` primitive, and grafted
# into the evaluated tree at `caos-core/`. std, tests and dev name a core item by a
# `DEPS` path (`../../caos-core/rustc rustc`), like any other dependency. Nothing
# here knows its own rev: whichever caos commit this tree is, it builds ITS core.
#
# This is the seed half of `stack/build-builtins.sh`, written as an expression.
# `--in:@=.` is the whole repo; nix keeps the repeated builds cheap, and each key
# is cached per rev.
# The three images are built CLEAN, and what a Rust edit moves is grafted on as
# layers: the static user db and /tmp (checked in), the caos binary, and the
# runner/cargo /worker, each its own small nix output. This is the delta
# `build-builtins.sh` stages by hand: {base, config.json, layer00.. }.
STATIC=graft --layer00:@=stack/core-layers/static
CAOSL=run --base:nix=v1 --in:@=. --attr=caos-core-layer-caos
RUNNERW=run --base:nix=v1 --in:@=. --attr=caos-core-layer-worker-runner
CARGOW=run --base:nix=v1 --in:@=. --attr=caos-core-layer-worker-cargo
RUNNER=graft --in=$RUNNERCLEAN --layer00:@=stack/core-layers/static --layer01=$CAOSL --layer02=$RUNNERW
FB=graft --in=$FBCLEAN --layer00:@=stack/core-layers/static --layer01=$CAOSL
CARGO=graft --in=$CARGOCLEAN --layer00:@=stack/core-layers/static --layer01=$CAOSL --layer02=$CARGOW
RUNNERCLEAN=run --base:nix=v1 --in:@=. --attr=caos-worker-runner-docker
FBCLEAN=run --base:nix=v1 --in:@=. --attr=caos-worker-flake-builder-docker
CARGOCLEAN=run --base:nix=v1 --in:@=. --attr=caos-worker-cargo-docker
DDBIN=run --base:nix=v1 --in:@=. --attr=worker-deep-deps
RUSTCBIN=run --base:nix=v1 --in:@=. --attr=worker-rustc
DD=curry --base=$RUNNER --worker1=$DDBIN/bin/worker-deep-deps
RUSTC=curry --base=$RUNNER --worker1=$RUSTCBIN/bin/worker-rustc --cargo=$CARGO --runner=$RUNNER --worker-common:@=rust/crates/worker-common
CORE=graft --runner=$RUNNER --flake-builder=$FB --cargo=$CARGO --rustc=$RUSTC --deep-deps=$DD
T=mount --in:@=. --caos-core=$CORE
run --base=$DD --in=$T
